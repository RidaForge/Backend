<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VELOCE Drive the Future</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800&family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

    <style>
        /* --- 1. VARIABLES & RESET --- */
        :root {
            --bg-dark: #050505;
            --bg-panel: #0f0f0f;
            --bg-panel-hover: #1a1a1a;
            --accent-red: #ff2a2a;
            --accent-blue: #00e5ff;
            --text-main: #ffffff;
            --text-muted: #888888;
            --glass: rgba(255, 255, 255, 0.05);
            --border: rgba(255, 255, 255, 0.1);
            --transition-fast: 0.3s ease;
            --transition-slow: 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            cursor: none; /* Custom cursor used */
        }

        html {
            scroll-behavior: smooth; /* Fallback */
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* --- 2. CUSTOM CURSOR --- */
        .cursor-dot, .cursor-outline {
            position: fixed;
            top: 0;
            left: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            z-index: 9999;
            pointer-events: none;
        }

        .cursor-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-red);
        }

        .cursor-outline {
            width: 40px;
            height: 40px;
            border: 1px solid var(--text-muted);
            transition: background-color 0.2s;
        }

        /* --- 3. TYPOGRAPHY & UTILITIES --- */
        h1, h2, h3, h4 {
            font-family: 'Orbitron', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .section-padding {
            padding: 100px 0;
        }

        .btn {
            display: inline-block;
            padding: 15px 40px;
            font-weight: 600;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
            border: 1px solid var(--accent-red);
            color: var(--text-main);
            font-size: 0.9rem;
            background: transparent;
            transition: color 0.3s;
        }

        .btn-primary {
            background-color: var(--accent-red);
            box-shadow: 0 0 20px rgba(255, 42, 42, 0.4);
        }

        .btn-primary:hover {
            color: white;
        }

        .btn-outline {
            border-color: var(--text-main);
        }

        .btn-outline:hover {
            background: var(--text-main);
            color: var(--bg-dark);
        }

        /* --- 4. NAVIGATION --- */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 0;
            z-index: 1000;
            background: rgba(5, 5, 5, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            transition: transform 0.4s ease, background 0.4s ease;
        }

        .nav-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: 4px;
        }

        .logo span { color: var(--accent-red); }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            opacity: 0.7;
            transition: opacity 0.3s;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--accent-red);
            transition: width 0.3s;
        }

        .nav-links a:hover { opacity: 1; }
        .nav-links a:hover::after { width: 100%; }

        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
        }

        /* --- 5. HERO SECTION --- */
        .hero {
            height: 100vh;
            width: 100%;
            background: linear-gradient(to bottom, rgba(5,5,5,0.3), var(--bg-dark)),
                        url('https://images.unsplash.com/photo-1503376763036-066120622c74?q=80&w=2070&auto=format&fit=crop') no-repeat center center/cover;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            will-change: background-position;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
        }

        .hero h1 {
            font-size: 4rem;
            line-height: 1.1;
            margin-bottom: 20px;
            opacity: 0; /* Animated in JS */
            transform: translateY(30px);
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            opacity: 0;
            transform: translateY(30px);
        }

        .hero-btns {
            opacity: 0;
            transform: translateY(30px);
            display: flex;
            gap: 20px;
        }

        /* --- 6. CARS / MODELS SECTION --- */
        .section-header {
            margin-bottom: 60px;
            text-align: center;
        }

        .section-header h2 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            opacity: 0;
            transform: translateY(30px);
        }

        .section-header .line {
            width: 60px;
            height: 3px;
            background: var(--accent-red);
            margin: 0 auto;
        }

        .car-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .car-card {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            position: relative;
            transform-style: preserve-3d; /* For Tilt Effect */
            will-change: transform;
        }

        .car-image {
            height: 250px;
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        .car-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            will-change: transform;
        }

        .car-details {
            padding: 25px;
            position: relative;
            z-index: 2;
            background: var(--bg-panel); /* Cover skewed image if any */
            transform: translateZ(20px); /* 3D pop */
        }

        .car-title {
            font-size: 1.5rem;
            margin-bottom: 5px;
            display: flex;
            justify-content: space-between;
        }

        .car-price {
            color: var(--accent-red);
            font-family: 'Montserrat', sans-serif;
        }

        .car-specs {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
            border-top: 1px solid var(--border);
            padding-top: 15px;
        }

        .spec-item {
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .spec-val {
            display: block;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 2px;
        }

        /* --- 7. ABOUT SECTION --- */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-text {
            padding-right: 20px;
        }

        .about-text p {
            margin-bottom: 20px;
            color: var(--text-muted);
        }

        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 30px;
        }

        .stat-card {
            background: var(--glass);
            padding: 20px;
            text-align: center;
            border: 1px solid var(--border);
        }

        .stat-number {
            display: block;
            font-size: 2.5rem;
            color: var(--accent-blue);
            font-family: 'Orbitron', sans-serif;
        }

        .about-image {
            position: relative;
            overflow: hidden;
            border-radius: 8px;
        }

        .about-image img {
            width: 100%;
            filter: grayscale(100%);
            transition: filter 0.5s ease;
            will-change: transform;
        }

        .about-image:hover img {
            filter: grayscale(0%);
        }

        /* --- 8. SERVICES SECTION --- */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .service-card {
            background: var(--bg-panel);
            padding: 40px 30px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid var(--border);
            transition: transform 0.3s ease, background 0.3s ease;
        }

        .service-card:hover {
            background: var(--bg-panel-hover);
            border-color: var(--accent-blue);
            transform: translateY(-5px);
        }

        .service-icon {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--accent-blue);
        }

        /* --- 9. GALLERY SECTION --- */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(2, 250px);
            gap: 10px;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            will-change: transform;
        }

        .gallery-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .gallery-item:hover .gallery-overlay {
            opacity: 1;
        }

        .gallery-overlay span {
            color: white;
            font-family: 'Orbitron', sans-serif;
            border-bottom: 2px solid var(--accent-red);
        }

        .g-wide { grid-column: span 2; }
        .g-tall { grid-row: span 2; }

        /* --- 10. CONTACT SECTION --- */
        .contact-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: var(--bg-panel);
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .contact-form {
            padding: 50px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .form-control {
            width: 100%;
            padding: 12px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            color: var(--text-main);
            font-family: inherit;
            transition: border-color 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent-red);
        }

        .contact-info {
            background: linear-gradient(135deg, #0f0f0f, #1a1a1a);
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .info-item {
            margin-bottom: 30px;
        }

        .info-item h4 {
            color: var(--accent-red);
            margin-bottom: 10px;
        }

        /* --- 11. FOOTER --- */
        footer {
            background: #000;
            padding: 50px 0 20px;
            border-top: 1px solid var(--border);
            text-align: center;
        }

        .socials {
            margin-bottom: 20px;
        }

        .social-link {
            color: var(--text-main);
            margin: 0 10px;
            text-decoration: none;
            font-size: 1.2rem;
            transition: color 0.3s;
        }

        .social-link:hover { color: var(--accent-red); }

        /* --- 12. ANIMATION & REVEAL CLASSES --- */
        .reveal-word {
            white-space: nowrap;
            display: inline-block;
        }

        /* Toast Notification */
        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--bg-panel);
            color: var(--text-main);
            padding: 15px 30px;
            border-left: 4px solid var(--accent-red);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            transform: translateX(200%);
            transition: transform 0.4s ease;
            z-index: 10000;
        }
        .toast.show { transform: translateX(0); }

        /* Responsive */
        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            .nav-links { display: none; }
            .mobile-toggle { display: block; color: white;}
            .about-grid, .contact-wrapper, .gallery-grid { grid-template-columns: 1fr; }
            .gallery-grid { grid-template-rows: auto; }
            .g-wide, .g-tall { grid-column: auto; grid-row: auto; }
            .gallery-item { height: 250px; }
            * { cursor: auto; } /* Reset cursor for touch */
            .cursor-dot, .cursor-outline { display: none; }
        }
    </style>
</head>
<body>

    <!-- CUSTOM CURSOR -->
    <div class="cursor-dot" data-cursor-dot></div>
    <div class="cursor-outline" data-cursor-outline></div>

    <!-- NAVIGATION -->
    <nav>
        <div class="container nav-inner">
            <div class="logo">VELOCE<span>.</span></div>
            <ul class="nav-links">
                <li><a href="#home" class="hover-trigger">Home</a></li>
                <li><a href="#models" class="hover-trigger">Models</a></li>
                <li><a href="#about" class="hover-trigger">About</a></li>
                <li><a href="#services" class="hover-trigger">Services</a></li>
                <li><a href="#gallery" class="hover-trigger">Gallery</a></li>
                <li><a href="#contact" class="hover-trigger">Contact</a></li>
            </ul>
            <div class="mobile-toggle hover-trigger">☰</div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <header id="home" class="hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="animate-hero">Drive The<br><span style="color:var(--accent-red)">Future</span></h1>
                <p class="animate-hero">Experience the perfect blend of luxury, performance, and futuristic design.</p>
                <div class="hero-btns animate-hero">
                    <a href="#models" class="btn btn-primary hover-trigger">Explore Cars</a>
                    <a href="#contact" class="btn btn-outline hover-trigger">Book Test Drive</a>
                </div>
            </div>
        </div>
    </header>

    <!-- MODELS SECTION -->
    <section id="models" class="section-padding">
        <div class="container">
            <div class="section-header">
                <h2>Our Models</h2>
                <div class="line"></div>
            </div>
            
            <div class="car-grid">
                <!-- Car 1 -->
                <div class="car-card hover-trigger">
                    <div class="car-image">
                        <img src="https://images.unsplash.com/photo-1617788138017-80ad40651399?q=80&w=2070&auto=format&fit=crop" alt="Veloce GT">
                    </div>
                    <div class="car-details">
                        <div class="car-title">
                            <span>VELOCE GT</span>
                            <span class="car-price">$145,000</span>
                        </div>
                        <div class="car-specs">
                            <div class="spec-item">
                                <span class="spec-val">3.2s</span>
                                0-60 mph
                            </div>
                            <div class="spec-item">
                                <span class="spec-val">580</span>
                                HP
                            </div>
                            <div class="spec-item">
                                <span class="spec-val">V8</span>
                                Turbo
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Car 2 -->
                <div class="car-card hover-trigger">
                    <div class="car-image">
                        <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=2070&auto=format&fit=crop" alt="Veloce SUV">
                    </div>
                    <div class="car-details">
                        <div class="car-title">
                            <span>VELOCE X</span>
                            <span class="car-price">$98,000</span>
                        </div>
                        <div class="car-specs">
                            <div class="spec-item">
                                <span class="spec-val">4.5s</span>
                                0-60 mph
                            </div>
                            <div class="spec-item">
                                <span class="spec-val">450</span>
                                HP
                            </div>
                            <div class="spec-item">
                                <span class="spec-val">V6</span>
                                Hybrid
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Car 3 -->
                <div class="car-card hover-trigger">
                    <div class="car-image">
                        <img src="https://images.unsplash.com/photo-1603584173870-7b299f589389?q=80&w=2064&auto=format&fit=crop" alt="Veloce Sport">
                    </div>
                    <div class="car-details">
                        <div class="car-title">
                            <span>V-SERIES S</span>
                            <span class="car-price">$220,000</span>
                        </div>
                        <div class="car-specs">
                            <div class="spec-item">
                                <span class="spec-val">2.8s</span>
                                0-60 mph
                            </div>
                            <div class="spec-item">
                                <span class="spec-val">720</span>
                                HP
                            </div>
                            <div class="spec-item">
                                <span class="spec-val">V10</span>
                                N/A
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section id="about" class="section-padding" style="background-color: #0a0a0a;">
        <div class="container">
            <div class="about-grid">
                <div class="about-image">
                    <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=2069&auto=format&fit=crop" alt="Car Factory">
                </div>
                <div class="about-text">
                    <h2 class="reveal-text">Defining Excellence</h2>
                    <div class="line" style="margin: 0 0 30px 0;"></div>
                    <p class="reveal-text">At VELOCE, we don't just build cars; we engineer dreams. Our commitment to innovation has driven us to the forefront of the automotive industry.</p>
                    <p class="reveal-text">From the drawing board to the asphalt, our focus remains on three pillars: Trust, Performance, and pure Innovation.</p>
                    
                    <div class="stat-grid">
                        <div class="stat-card hover-trigger">
                            <span class="stat-number">15+</span>
                            Years Experience
                        </div>
                        <div class="stat-card hover-trigger">
                            <span class="stat-number">200</span>
                            Awards Won
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICES SECTION -->
    <section id="services" class="section-padding">
        <div class="container">
            <div class="section-header">
                <h2 class="reveal-text">Services</h2>
                <div class="line"></div>
            </div>
            <div class="services-grid">
                <div class="service-card hover-trigger">
                    <div class="service-icon">⚡</div>
                    <h3>Premium Sales</h3>
                    <p>Exclusive access to the world's most sought-after vehicles with white-glove delivery service.</p>
                </div>
                <div class="service-card hover-trigger">
                    <div class="service-icon">💰</div>
                    <h3>Financing</h3>
                    <p>Flexible, bespoke financial solutions tailored to your portfolio and lifestyle needs.</p>
                </div>
                <div class="service-card hover-trigger">
                    <div class="service-icon">🔧</div>
                    <h3>Maintenance</h3>
                    <p>Certified specialists ensuring your vehicle performs at peak condition using genuine parts.</p>
                </div>
                <div class="service-card hover-trigger">
                    <div class="service-icon">🎨</div>
                    <h3>Custom Mods</h3>
                    <p>Personalization studio for body kits, performance tuning, and bespoke interiors.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- GALLERY SECTION -->
    <section id="gallery" class="section-padding" style="padding-bottom: 50px;">
        <div class="container">
            <div class="section-header">
                <h2 class="reveal-text">Gallery</h2>
                <div class="line"></div>
            </div>
            <div class="gallery-grid">
                <div class="gallery-item g-wide hover-trigger">
                    <img src="https://images.unsplash.com/photo-1507136566006-cfc505b114fc?q=80&w=2073&auto=format&fit=crop" alt="Dashboard">
                    <div class="gallery-overlay"><span>INTERIOR</span></div>
                </div>
                <div class="gallery-item g-tall hover-trigger">
                    <img src="https://images.unsplash.com/photo-1544636331-e26879cd4d9b?q=80&w=1974&auto=format&fit=crop" alt="Side View">
                    <div class="gallery-overlay"><span>AERODYNAMICS</span></div>
                </div>
                <div class="gallery-item hover-trigger">
                    <img src="https://images.unsplash.com/photo-1489824904134-891ab64532f1?q=80&w=2070&auto=format&fit=crop" alt="Headlight">
                    <div class="gallery-overlay"><span>DETAILS</span></div>
                </div>
                <div class="gallery-item hover-trigger">
                    <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=2069&auto=format&fit=crop" alt="Wheel">
                    <div class="gallery-overlay"><span>ALLOYS</span></div>
                </div>
                <div class="gallery-item g-wide hover-trigger">
                    <img src="https://images.unsplash.com/photo-1616422285623-13ff0162193c?q=80&w=2069&auto=format&fit=crop" alt="Engine">
                    <div class="gallery-overlay"><span>POWER</span></div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="section-padding">
        <div class="container">
            <div class="section-header">
                <h2 class="reveal-text">Contact Us</h2>
                <div class="line"></div>
            </div>
            <div class="contact-wrapper">
                <form class="contact-form" id="bookingForm">
                    <h3 style="margin-bottom: 20px;">Book a Test Drive</h3>
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" class="form-control hover-trigger" required>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" class="form-control hover-trigger" required>
                    </div>
                    <div class="form-group">
                        <label>Select Model</label>
                        <select class="form-control hover-trigger">
                            <option>VELOCE GT</option>
                            <option>VELOCE X</option>
                            <option>V-SERIES S</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Message</label>
                        <textarea class="form-control hover-trigger" rows="4"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary hover-trigger">Request Booking</button>
                </form>

                <div class="contact-info">
                    <div class="info-item">
                        <h4>Visit Showroom</h4>
                        <p>1200 Future Blvd, Innovation District<br>Los Angeles, CA 90012</p>
                    </div>
                    <div class="info-item">
                        <h4>Business Hours</h4>
                        <p>Mon - Fri: 9:00 AM - 9:00 PM<br>Sat - Sun: 10:00 AM - 6:00 PM</p>
                    </div>
                    <div class="info-item">
                        <h4>Contact</h4>
                        <p>+1 (800) 555-0199<br>sales@veloce-auto.com</p>
                    </div>
                    <!-- Map Placeholder -->
                    <div style="width: 100%; height: 150px; background: #222; display: flex; align-items: center; justify-content: center; color: #555;">
                        Interactive Map Placeholder
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="socials">
                <a href="#" class="social-link hover-trigger">Instagram</a>
                <a href="#" class="social-link hover-trigger">Twitter</a>
                <a href="#" class="social-link hover-trigger">YouTube</a>
            </div>
            <p style="color: #555; font-size: 0.8rem;">&copy; 2023 VELOCE Automotive. All Rights Reserved. Designed for Premium Excellence.</p>
        </div>
    </footer>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="toast">Request Sent! We will contact you shortly.</div>

    <script>
        /**
         * VELOCE | Premium Front-End Interaction Engine
         * High-performance, zero-dependency, luxury automotive experience.
         */

        // --- 1. UTILITIES & STATE MANAGEMENT ---
        const Utils = {
            lerp: (start, end, factor) => start + (end - start) * factor,
            clamp: (num, min, max) => Math.min(Math.max(num, min), max)
        };

        const State = {
            width: window.innerWidth,
            height: window.innerHeight,
            mouseX: 0,
            mouseY: 0,
            scrollY: 0,
            smoothScrollY: 0,
            targetScrollY: 0,
            scrollDirection: 'down',
            isMobile: window.innerWidth <= 768,
            ticking: false
        };

        window.addEventListener('resize', () => {
            State.width = window.innerWidth;
            State.height = window.innerHeight;
            State.isMobile = window.innerWidth <= 768;
        });

        // --- 2. CUSTOM CURSOR ENGINE ---
        class Cursor {
            constructor() {
                this.dot = document.querySelector('[data-cursor-dot]');
                this.outline = document.querySelector('[data-cursor-outline]');
                this.triggers = document.querySelectorAll('.hover-trigger, .btn, a');
                this.pos = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
                this.cursorScale = 1;
                this.init();
            }

            init() {
                if (State.isMobile) {
                    this.dot.style.display = 'none';
                    this.outline.style.display = 'none';
                    return;
                }

                document.addEventListener('mousemove', (e) => {
                    State.mouseX = e.clientX;
                    State.mouseY = e.clientY;
                });

                this.attachHoverEffects();
                this.animate();
            }

            attachHoverEffects() {
                this.triggers.forEach(el => {
                    el.addEventListener('mouseenter', () => {
                        this.cursorScale = 1.5;
                        this.outline.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
                        this.outline.style.borderColor = 'var(--accent-red)';
                    });
                    el.addEventListener('mouseleave', () => {
                        this.cursorScale = 1;
                        this.outline.style.backgroundColor = 'transparent';
                        this.outline.style.borderColor = 'rgba(255, 255, 255, 0.1)';
                    });
                });
            }

            animate() {
                this.dot.style.left = `${State.mouseX}px`;
                this.dot.style.top = `${State.mouseY}px`;

                const dt = 0.15;
                const elPos = { x: parseFloat(this.outline.style.left) || State.mouseX, y: parseFloat(this.outline.style.top) || State.mouseY };
                
                const nextX = Utils.lerp(elPos.x, State.mouseX, dt);
                const nextY = Utils.lerp(elPos.y, State.mouseY, dt);

                this.outline.style.left = `${nextX}px`;
                this.outline.style.top = `${nextY}px`;
                
                const currentScale = parseFloat(this.outline.getAttribute('data-scale') || 1);
                const nextScale = Utils.lerp(currentScale, this.cursorScale, 0.2);
                this.outline.style.transform = `translate(-50%, -50%) scale(${nextScale})`;
                this.outline.setAttribute('data-scale', nextScale);

                requestAnimationFrame(() => this.animate());
            }
        }

        // --- 3. SCROLL & INERTIA ENGINE ---
        class ScrollManager {
            constructor() { this.init(); }

            init() {
                window.addEventListener('scroll', () => {
                    State.targetScrollY = window.scrollY;
                    State.scrollDirection = State.scrollY > State.targetScrollY ? 'down' : 'up';
                    State.scrollY = window.scrollY;
                });
                this.loop();
            }

            loop() {
                State.smoothScrollY = Utils.lerp(State.smoothScrollY, State.targetScrollY, 0.08);
                requestAnimationFrame(() => this.loop());
            }
        }

        // --- 4. SMART NAVBAR ---
        class SmartNav {
            constructor() {
                this.nav = document.querySelector('nav');
                this.lastScroll = 0;
                this.tolerance = 5;
                this.init();
            }

            init() { window.addEventListener('scroll', () => this.checkScroll(), { passive: true }); }

            checkScroll() {
                const currentScroll = State.targetScrollY;
                if (Math.abs(currentScroll - this.lastScroll) <= this.tolerance) return;

                if (currentScroll > this.lastScroll && currentScroll > 100) {
                    this.nav.style.transform = 'translateY(-100%)';
                } else {
                    this.nav.style.transform = 'translateY(0)';
                }

                if (currentScroll > 50) {
                    this.nav.style.background = 'rgba(5, 5, 5, 0.95)';
                    this.nav.style.boxShadow = '0 10px 30px rgba(0,0,0,0.5)';
                } else {
                    this.nav.style.background = 'rgba(5, 5, 5, 0.8)';
                    this.nav.style.boxShadow = 'none';
                }
                this.lastScroll = currentScroll;
            }
        }

        // --- 5. MAGNETIC BUTTONS ---
        class MagneticButtons {
            constructor() {
                this.buttons = document.querySelectorAll('.btn');
                if (State.isMobile) return;
                this.init();
            }

            init() {
                this.buttons.forEach(btn => {
                    btn.addEventListener('mousemove', (e) => this.move(e, btn));
                    btn.addEventListener('mouseleave', (e) => this.reset(e, btn));
                });
            }

            move(e, btn) {
                const rect = btn.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
            }

            reset(e, btn) { btn.style.transform = `translate(0px, 0px)`; }
        }

        // --- 6. 3D TILT EFFECT ---
        class TiltEffect {
            constructor() {
                this.cards = document.querySelectorAll('.car-card');
                if (State.isMobile) return;
                this.init();
            }

            init() {
                this.cards.forEach(card => {
                    card.addEventListener('mousemove', (e) => this.handleMove(e, card));
                    card.addEventListener('mouseleave', (e) => this.handleLeave(e, card));
                });
            }

            handleMove(e, card) {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((y - centerY) / centerY) * -5;
                const rotateY = ((x - centerX) / centerX) * 5;
                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
                card.style.zIndex = '10';
            }

            handleLeave(e, card) {
                card.style.transform = `perspective(1000px) rotateX(0) rotateY(0) scale(1)`;
                card.style.zIndex = '1';
            }
        }

        // --- 7. IMAGE PARALLAX ---
        class ParallaxManager {
            constructor() {
                this.images = document.querySelectorAll('.car-image img, .gallery-item img, .about-image img');
                this.hero = document.querySelector('.hero');
                this.init();
            }

            init() { this.loop(); }

            loop() {
                if (State.isMobile) { requestAnimationFrame(() => this.loop()); return; }

                this.images.forEach(img => {
                    const rect = img.getBoundingClientRect();
                    const center = rect.top + rect.height / 2;
                    const offset = center - State.height / 2;
                    if (rect.bottom > 0 && rect.top < State.height) {
                        let speed = 0.05;
                        if(img.closest('.gallery-item')) speed = 0.03;
                        if(img.closest('.about-image')) speed = 0.08;
                        const yPos = offset * speed;
                        img.style.transform = `translate3d(0, ${yPos}px, 0) scale(1.1)`;
                    }
                });

                if (this.hero) {
                    const yPos = State.smoothScrollY * 0.3;
                    this.hero.style.backgroundPosition = `center ${yPos}px`;
                }

                requestAnimationFrame(() => this.loop());
            }
        }

        // --- 8. TEXT REVEAL ---
        class TextReveal {
            constructor() {
                this.elements = document.querySelectorAll('.reveal-text, .section-header h2');
                this.init();
            }

            init() {
                this.elements.forEach(el => {
                    if (el.classList.contains('reveal-processed')) return;
                    const text = el.innerText.trim();
                    el.innerHTML = '';
                    const words = text.split(' ');
                    words.forEach((word, index) => {
                        const span = document.createElement('span');
                        span.className = 'reveal-word';
                        span.innerText = word + ' ';
                        span.style.display = 'inline-block';
                        span.style.opacity = '0';
                        span.style.transform = 'translateY(20px)';
                        span.style.transition = `opacity 0.6s ease, transform 0.6s ease`;
                        span.style.transitionDelay = `${index * 40}ms`;
                        el.appendChild(span);
                    });
                    el.classList.add('reveal-processed');
                });
                this.observe();
            }

            observe() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const words = entry.target.querySelectorAll('.reveal-word');
                            words.forEach(w => {
                                w.style.opacity = '1';
                                w.style.transform = 'translateY(0)';
                            });
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });
                this.elements.forEach(el => observer.observe(el));
            }
        }

        // --- 9. CINEMATIC INTRO ---
        class CinematicIntro {
            constructor() {
                this.intro = document.createElement('div');
                this.createLoader();
            }

            createLoader() {
                this.intro.style.cssText = `
                    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                    background: #000; z-index: 99999;
                    display: flex; justify-content: center; align-items: center; pointer-events: none;
                `;
                const logo = document.createElement('div');
                logo.innerText = 'VELOCE';
                logo.style.cssText = `
                    font-family: 'Orbitron', sans-serif; font-size: 3rem; color: white;
                    letter-spacing: 10px; opacity: 0; transform: scale(0.9);
                    transition: opacity 1s ease, transform 1s cubic-bezier(0.19, 1, 0.22, 1);
                `;
                this.intro.appendChild(logo);
                document.body.appendChild(this.intro);
                this.playSequence(logo);
            }

            playSequence(logo) {
                setTimeout(() => {
                    logo.style.opacity = '1'; logo.style.transform = 'scale(1)';
                }, 100);
                setTimeout(() => {
                    this.intro.style.opacity = '0'; this.intro.style.transition = 'opacity 1s ease';
                    const heroElements = document.querySelectorAll('.animate-hero');
                    heroElements.forEach((el, index) => {
                        setTimeout(() => {
                            el.style.transition = "all 1s cubic-bezier(0.19, 1, 0.22, 1)";
                            el.style.opacity = "1"; el.style.transform = "translateY(0)";
                        }, 300 * (index + 1));
                    });
                }, 1500);
                setTimeout(() => { this.intro.remove(); }, 2500);
            }
        }

        // --- 10. MAIN INIT & FORM HANDLING ---
        document.addEventListener('DOMContentLoaded', () => {
            new CinematicIntro();
            new ScrollManager();
            new Cursor();
            new SmartNav();
            new MagneticButtons();
            new TiltEffect();
            new ParallaxManager();
            setTimeout(() => new TextReveal(), 1000);

            // Basic Form Handling
            const form = document.getElementById('bookingForm');
            const toast = document.getElementById('toast');
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const btn = form.querySelector('button');
                const originalText = btn.innerText;
                btn.innerText = "Sending...";
                setTimeout(() => {
                    btn.innerText = "Sent";
                    btn.style.backgroundColor = "#28a745";
                    btn.style.borderColor = "#28a745";
                    toast.classList.add('show');
                    setTimeout(() => {
                        form.reset();
                        btn.innerText = originalText;
                        btn.style.backgroundColor = ""; btn.style.borderColor = "";
                        toast.classList.remove('show');
                    }, 3000);
                }, 1500);
            });

            // Mobile Menu Toggle
            const mobileToggle = document.querySelector('.mobile-toggle');
            const navLinks = document.querySelector('.nav-links');
            mobileToggle.addEventListener('click', () => {
                const currentDisplay = window.getComputedStyle(navLinks).display;
                if (currentDisplay === 'none') {
                    navLinks.style.display = 'flex'; navLinks.style.flexDirection = 'column';
                    navLinks.style.position = 'absolute'; navLinks.style.top = '70px'; navLinks.style.left = '0';
                    navLinks.style.width = '100%'; navLinks.style.background = '#050505';
                    navLinks.style.padding = '20px'; navLinks.style.borderBottom = '1px solid #333';
                } else {
                    navLinks.style.display = 'none';
                }
            });
            window.addEventListener('resize', () => {
                if (window.innerWidth > 768) {
                    navLinks.style.display = 'flex'; navLinks.style.position = 'static';
                    navLinks.style.flexDirection = 'row'; navLinks.style.background = 'transparent';
                    navLinks.style.borderBottom = 'none'; navLinks.style.padding = '0';
                } else { navLinks.style.display = 'none'; }
            });
        });
    </script>
</body>
</html>